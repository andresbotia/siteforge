# SiteForge environment variables
# None of these are required to run Milestone 1.
# The application uses mock data and does not call external services.

# Supabase — database, authentication, application state
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# xAI — Grok agent execution
XAI_API_KEY=

# Vercel — preview and production deployments
VERCEL_TOKEN=

# Resend — outbound and inbound email
RESEND_API_KEY=

# Stripe — payments and subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
