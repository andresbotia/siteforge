# SiteForge environment variables
# Do not commit real values. Copy this file to .env.local for local development.

# Temporary single-admin authentication (Milestone 1)
# Required to sign in to the dashboard. Leave empty in this example file.
# Generate SITEFORGE_AUTH_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SITEFORGE_ADMIN_EMAIL=
SITEFORGE_ADMIN_PASSWORD=
SITEFORGE_AUTH_SECRET=

# Supabase
# URL may remain public. Application table access is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key (sb_secret_...). Never prefix with NEXT_PUBLIC_.
# Dashboard: Project Settings → API Keys → Secret keys
# Required for SiteForge to read application tables after public SELECT was removed.
SUPABASE_SECRET_KEY=

# xAI — Grok inference (server-only). Leave empty until you explicitly approve spend.
# Create the key in the xAI console. Never put it in NEXT_PUBLIC_* or client code.
XAI_API_KEY=

# Must be exactly "true" to allow a live paid inference call. Default off.
# Approving a paid-AI run does not call xAI. Live execution is a separate gate.
XAI_ALLOW_LIVE_INFERENCE=

# Vercel — preview and production deployments
VERCEL_TOKEN=

# Resend — outbound and inbound email
RESEND_API_KEY=

# Stripe — payments and subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
