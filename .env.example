# SiteForge environment variables. Safe placeholders only.
# Do not commit real values. Copy this file to .env.local for local development.
# Secrets must never use NEXT_PUBLIC_.

# Temporary admin auth
# Required locally and in Vercel. Server-only.
# Generate SITEFORGE_AUTH_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SITEFORGE_ADMIN_EMAIL=
SITEFORGE_ADMIN_PASSWORD=
SITEFORGE_AUTH_SECRET=

# Supabase
# Required locally and in Vercel.
# Browser-safe project URL and publishable key; application table access remains server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key (sb_secret_...). Required locally and in Vercel.
# Dashboard: Project Settings -> API Keys -> Secret keys
SUPABASE_SECRET_KEY=

# xAI
# Optional server-only credential. Required only for explicitly approved live paid inference.
XAI_API_KEY=

# Live-action gate. Must be exactly "true" and paired with approved budget before a live paid call.
# Leave unset/false for development and M9.5A.
XAI_ALLOW_LIVE_INFERENCE=

# Vercel
# Optional server-only token for future deployment automation. Do not configure for M9.5A automation.
VERCEL_TOKEN=

# Resend
# Optional server-only credential for future M9.5C email integration. Mock email remains active in M9.5A.
RESEND_API_KEY=

# Stripe
# Optional server-only credentials. Mock Stripe remains default unless live gate is exactly "true".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Live-action gate. Leave unset/false for development and M9.5A.
STRIPE_ALLOW_LIVE_PAYMENTS=
